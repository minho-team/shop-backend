<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.CartItemMapper">
	<insert id="addCartItem">
		insert into cart_item(cart_item_no, cart_no, product_option_no, quantity, created_at) 
		values(seq_cart_item.nextval(), #{cartNo}, #{productOptionNo}, #{quantity}, #{createdAt})
	</insert>
	<delete id="deleteCartItem">
		delete from cart_item 
		where cart_item_no = #{cartItemNo}
	</delete>
	<delete id="deleteAllCartItem">
		delete from cart_item 
	</delete>
	<update id="updateCartItem">
		update cart_item set where cart_item_no = #{cartItemNo}  
	</update>
	<select id="readAllCartItem">
		select * from cart_item 
	</select>
</mapper>