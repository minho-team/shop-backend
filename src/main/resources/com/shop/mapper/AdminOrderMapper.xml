<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.AdminOrderMapper">

<!-- =========================
         1. 주문 목록 조회
    ========================== -->
<select id="getOrderList" resultType="com.shop.dto.admin.order.AdminOrderListDTO">

    SELECT
        order_no,
        member_no,
        orderer_name,
        order_status,
        total_price,
        refund_status,
        created_at
    FROM orders
    ORDER BY order_no DESC

</select>


	
</mapper>



















