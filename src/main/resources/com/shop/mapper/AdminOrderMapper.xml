<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.AdminOrderMapper">

	<!-- ========================= 
		 1. 주문 목록 조회 
	========================== -->
	<select id="getOrderList"
		resultType="com.shop.dto.admin.order.AdminOrderListDTO">
		SELECT
		order_no,
		member_no,
		orderer_name,
		order_status,
		total_price,
		refund_status,
		created_at
		FROM orders
		ORDER BY order_no DESC
	</select>

	<!-- =========================
	     2. 주문 상세 조회
	========================== -->
	<select id="getOrder" resultType="com.shop.dto.admin.order.AdminOrderReadDTO">
        SELECT *
        FROM orders
        WHERE order_no = #{orderNo}
    </select>

	<!-- =========================
         3. 주문 상품 목록 조회
    ========================== -->
	<select id="getOrderItems" resultType="com.shop.dto.admin.order.AdminOrderItemDTO">
        SELECT *
        FROM order_item
        WHERE order_no = #{orderNo}
    </select>

	<!-- =========================
	     4. 주문 상태 변경
	========================== -->
	<update id="updateOrderStatus">
        UPDATE orders
        SET order_status = #{requestDTO.orderStatus}
        WHERE order_no = #{orderNo}
    </update>
	
	<!-- =========================
         5. 환불 상태 변경
    ========================== -->
    <update id="updateRefundStatus">
        UPDATE orders
        SET refund_status = #{requestDTO.refundStatus}
        WHERE order_no = #{orderNo}
    </update>
    
</mapper>



















