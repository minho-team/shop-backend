<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.mapper.PointMapper">

	<!-- DB 컬럼명 → Java 필드명 매핑 -->
	<resultMap type="com.shop.domain.Point" id="pointMap">
		<id property="pointNo" column="point_no" />
		<result property="memberNo" column="member_no" />
		<result property="point" column="point" />
		<result property="type" column="type" />
		<result property="createdAt" column="created_at" />
	</resultMap>

	<!-- ================================================ -->
	<!-- 포인트 저장 -->
	<!-- createdAt은 DB에서 SYSTIMESTAMP로 자동 처리 -->
	<!-- ================================================ -->
	<insert id="insertPoint" parameterType="com.shop.domain.Point">
		<selectKey keyProperty="pointNo" resultType="long"
			order="BEFORE">
			SELECT seq_point.NEXTVAL FROM dual
		</selectKey>
		INSERT INTO point (point_no, member_no, point, type, created_at)
		VALUES (#{pointNo}, #{memberNo}, #{point}, #{type}, SYSTIMESTAMP)
	</insert>

	<!-- ================================================ -->
	<!-- 특정 회원 포인트 잔액 조회 -->
	<!-- SUM으로 계산 (적립=양수, 차감=음수 합산) -->
	<!-- 이력이 없으면 0 반환 -->
	<!-- ================================================ -->
	<select id="selectPointBalance" resultType="int">
		SELECT NVL(SUM(point), 0)
		FROM point
		WHERE member_no = #{memberNo}
	</select>

	<!-- ================================================ -->
	<!-- 특정 회원 포인트 이력 페이징 조회 (최신순) -->
	<!-- ================================================ -->
	<select id="selectPointsByMemberNo" resultMap="pointMap">
		SELECT *
		FROM (
		SELECT p.*, ROWNUM AS rn
		FROM (
		SELECT point_no, member_no, point, type, created_at
		FROM point
		WHERE member_no = #{memberNo}
		ORDER BY created_at DESC
		) p
		WHERE ROWNUM &lt;= #{endRow}
		)
		WHERE rn &gt;= #{startRow}
	</select>

	<!-- ================================================ -->
	<!-- 특정 회원 포인트 이력 총 건수 -->
	<!-- ================================================ -->
	<select id="countPointsByMemberNo" resultType="int">
		SELECT COUNT(*)
		FROM point
		WHERE member_no = #{memberNo}
	</select>

</mapper>